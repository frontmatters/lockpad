# notepad-secure — environment template.
#
# Copy to .env and fill in:   cp .env.example .env && $EDITOR .env
# .env is gitignored and .dockerignored — never baked into the image.

# ----------------------------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------------------------

# Server-side HMAC key. Without it, the storage filename would be a pure
# function of user-known material (auth_key), making the whole corpus
# offline-brute-forceable on backup leak (audit CRITICAL #1).
#
# Minimum 32 characters. Pick something you will not lose — rotating this
# invalidates every existing note on the server, since every storage filename
# is derived from it.
#
# Generate:
#   openssl rand -base64 48
#
SERVER_SECRET=

# ----------------------------------------------------------------------------
# OPTIONAL
# ----------------------------------------------------------------------------

# Domain for the Caddy reverse proxy.
#   * Real public domain  → Caddy auto-issues a Let's Encrypt cert.
#   * notepad.local       → Caddy uses its internal CA (LAN / Tailscale-MagicDNS).
#   * :80                 → plain HTTP, no TLS (only for terminating proxy upstream).
DOMAIN=notepad.local
