# Lockpad — environment template.
#
# Copy to .env and fill in:   cp .env.example .env && $EDITOR .env
# .env is gitignored and .dockerignored — never baked into the image.

# ----------------------------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------------------------

# Server-side HMAC key. Without it, the storage filename would be a pure
# function of user-known material (auth_key), making the whole corpus
# offline-brute-forceable on backup leak (audit CRITICAL #1).
#
# Minimum 32 characters. Pick something you will not lose — rotating this
# invalidates every existing note on the server, since every storage filename
# is derived from it.
#
# Generate:
#   openssl rand -base64 48
#
SERVER_SECRET=

# ----------------------------------------------------------------------------
# OPTIONAL
# ----------------------------------------------------------------------------

# Host address the Docker port is bound to.
#   * 127.0.0.1  → localhost-only (default; safest)
#   * 0.0.0.0    → all interfaces (LAN access — HTTP only, no TLS!)
#   * <host-IP>  → specific interface only (multi-NIC hosts)
#
# Lockpad has no authentication at the network layer (the passphrase encrypts
# notes client-side, but anyone reaching the service can hit the API). For
# anything beyond your own machine, prefer running Caddy in front and keeping
# this at 127.0.0.1.
LOCKPAD_BIND=127.0.0.1

# Disable HTTPS-only response headers (`upgrade-insecure-requests` in CSP +
# HSTS). Required when serving Lockpad over plain HTTP without a reverse
# proxy in front — without this, browsers auto-upgrade asset requests to
# HTTPS, find no TLS server, and the UI fails to load (favicon + bundle
# blocked, "CORS"-looking errors). Set to `true` only when:
#   * LOCKPAD_BIND=0.0.0.0 (or a specific NIC IP) AND
#   * no Caddy / Traefik / nginx in front terminating TLS.
# Defaults to false — the safe choice for production behind a proxy.
LOCKPAD_PLAIN_HTTP=false

# Domain for the Caddy reverse proxy.
#   * Real public domain  → Caddy auto-issues a Let's Encrypt cert.
#   * lockpad.local       → Caddy uses its internal CA (LAN / Tailscale-MagicDNS).
#   * :80                 → plain HTTP, no TLS (only for terminating proxy upstream).
DOMAIN=lockpad.local

# Max encrypted-note blob size. Swap the value below to tune this instance.
# Accepts:
#   - Sentinel:     DEFAULT       (tracks the built-in default; currently 64 KiB)
#   - Human units:  1mb  |  750kb  |  64kib
#   - Raw bytes:    65536
#   - Unset/empty:                (same as DEFAULT)
#
# 64 KiB ≈ 40000 plaintext chars after AES-GCM + base64 envelope overhead.
# Raising this enlarges DoS surface (memory per request + storage exhaustion
# window on key leak) proportionally. The app warns at startup if the chosen
# value needs more memory than the container's `mem_limit` — no need to guess
# ahead of time.
MAX_BLOB_SIZE=DEFAULT
