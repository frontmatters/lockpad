# Source control & docker meta
.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
docker-compose.*.yml

# Secrets — must never enter the image
.env
.env.*
!.env.example

# Build artifacts (regenerated inside the multi-stage build)
backend/dist
backend/node_modules
frontend/dist
frontend/node_modules
node_modules

# Runtime state (private notes, never bake into image)
backend/storage
backend/public/backups

# Editor / OS noise
.idea
.vscode
.DS_Store
Thumbs.db

# Logs / coverage
*.log
npm-debug.log*
coverage
