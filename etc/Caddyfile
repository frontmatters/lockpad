# Lockpad — Caddyfile.
#
# Configured via the $DOMAIN env var (see .env.example). Defaults to
# lockpad.local for LAN / Tailscale-MagicDNS deployments where Caddy uses
# its internal CA. For a public domain, Caddy obtains Let's Encrypt certs
# automatically.

{
	admin off
}

{$DOMAIN:lockpad.local} {
	encode gzip zstd

	# Strip Caddy's own version banner.
	header -Server

	# Defense-in-depth security headers. Helmet inside the backend sets these
	# too, but duplicating at the edge means a misconfigured backend still
	# ships sane defaults. CSP is set inside the backend (where it has the
	# nonce/hash context for the SPA bundle) and not duplicated here to avoid
	# conflicting policies.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "no-referrer"
		X-Frame-Options           "DENY"
		Permissions-Policy        "interest-cohort=(), browsing-topics=()"
	}

	# Cap upload size. Backend's helmet/body-parser enforces a tighter 64kb;
	# this is an upstream filter to reject obviously invalid clients early.
	request_body {
		max_size 256kb
	}

	# Single proxy for everything: /api/* AND the SPA static assets. The
	# backend's express.static serves the built frontend from /app/backend/public.
	# This means there is exactly one rate-limit policy (the backend's), one
	# auth-header check, and crucially: NO separate `file_server` with a `browse`
	# directive that could ever expose a /backups/ tarball directory listing.
	# (This was audit CRITICAL #2 in the upstream Caddyfile.)
	reverse_proxy localhost:3000 {
		header_down -Server
		header_down -X-Powered-By
	}

	handle_errors {
		respond "{err.status_code}"
	}
}
